<?xml version="1.0"?>
<ruleset name="wvoce-iscrizioni">
	<description>Regole di scrittura del plugin: WordPress Coding Standards e compatibilità con PHP 7.4.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="7.4-"/>

	<!-- Chiamate con un array o una funzione come ultimo argomento sulla stessa riga e array associativi
	     brevi su una riga, come nel tema VivaVoce. -->
	<rule ref="WordPress-Extra">
		<exclude name="PEAR.Functions.FunctionCallSignature.MultipleArguments"/>
		<exclude name="PEAR.Functions.FunctionCallSignature.ContentAfterOpenBracket"/>
		<exclude name="PEAR.Functions.FunctionCallSignature.CloseBracketLine"/>
		<exclude name="WordPress.Arrays.ArrayDeclarationSpacing.AssociativeArrayFound"/>
		<exclude name="WordPress.Arrays.ArrayDeclarationSpacing.ArrayItemNoNewLine"/>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wvoce-iscrizioni"/>
			</property>
		</properties>
	</rule>
	<!-- Prefisso wvi_ (wvoce-iscrizioni): WPCS lo considera corto, ma la regola resta accesa e controlla che
	     ogni funzione, costante e opzione lo abbia. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.ShortPrefixPassed"/>
		<properties>
			<property name="prefixes" type="array">
				<element value="wvi"/>
			</property>
		</properties>
	</rule>
</ruleset>
